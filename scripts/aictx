def cmd_doctor(args):
    """Validate integrity of ai-context resources with premium reporting."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    B = "\033[1m"; G = "\033[92m"; Y = "\033[93m"; R = "\033[31m"; C = "\033[96m"; DIM = "\033[2m"; RES = "\033[0m"
    print(f"\n{B}🩺 AI Context — Health Check{RES}")
    print(f"   {DIM}Source: {AICTX_HOME}{RES}\n")
    errors, warnings, ok = [], [], []
    skills_dir = AICTX_HOME / "skills"
    agents_dir = AICTX_HOME / "agents"
    if skills_dir.exists():
        for d in sorted(skills_dir.iterdir()):
            if d.is_dir():
                if not any((d / f).exists() for f in ["SKILL.md", "skill.md"]):
                    errors.append(f"skills/{d.name}/ — missing SKILL.md")
                else: ok.append(f"skills/{d.name}/SKILL.md")
    if agents_dir.exists():
        for agent_file in sorted(agents_dir.glob("*.md")):
            fm = read_frontmatter(agent_file)
            skill_refs = [s.strip() for s in fm.get("skills", "").split(",") if s.strip()]
            for ref in skill_refs:
                if not (skills_dir / ref).exists():
                    errors.append(f"agents/{agent_file.name} → skill \"{ref}\" not found")
                else: ok.append(f"agents/{agent_file.name} → {ref} ✓")
    if errors:
        print(f"{R}❌ {len(errors)} error(s):{RES}")
        for e in errors: print(f"   {R}✗{RES}  {e}")
        print()
    if warnings:
        print(f"{Y}⚠️  {len(warnings)} warning(s):{RES}")
        for w in warnings: print(f"   {Y}!{RES}  {w}")
        print()
    print(f"{G}✅ {len(ok)} check(s) passed{RES}\n")
    if getattr(args, "fix", False) and errors:
        print(f"{B}🔨 Sanitizing resources...{RES}\n")
        for err in [e for e in errors if "missing SKILL.md" in e]:
            folder = err.split("/")[1]
            (skills_dir / folder / "SKILL.md").write_text(f"---\nname: {folder}\ndescription: Auto-generated.\n---\n")
            print(f"   {G}✓{RES} Created missing skills/{folder}/SKILL.md")
        for agent_file in sorted(agents_dir.glob("*.md")):
            c = agent_file.read_text()
            fm = read_frontmatter(agent_file)
            refs = [s.strip() for s in fm.get("skills", "").split(",") if s.strip()]
            new_refs = [r for r in refs if (skills_dir / r).exists()]
            if len(refs) != len(new_refs):
                import re
                c = re.sub(r"skills:.*", f"skills: {', '.join(new_refs)}", c)
                agent_file.write_text(c)
                print(f"   {G}✓{RES} Cleaned orphan skills in {agent_file.name}")
        print(f"\n✨ Sanitization complete. Run {C}aictx sync{RES} to update manifests.\n")
    elif errors:
        print(f"💡 {B}Tip:{RES} Run {C}aictx doctor --fix{RES} to auto-repair issues.\n")
    return 0

def cmd_add(args):
    """Scaffold a new skill or agent."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    
    kind = normalize_archivable_type(args.kind) if args.kind else None
    name = args.name
    
    if not kind:
        items = [{"name": k, "desc": ""} for k in ["skill", "agent"]]
        selection = TUISelector.select("Select resource type to add:", items)
        if not selection: return 0
        kind = selection[0]["name"]

    if not name:
        name = input(f"Enter {kind} name: ").strip()
        if not name: return 0

    name = name.lower().replace(" ", "-")
    description = (getattr(args, "description", "") or "").strip()
    tags = (getattr(args, "tags", "") or "").strip()
    
    if kind == "skill":
        target = AICTX_HOME / "skills" / name
        if target.exists():
            print(f"⚠️  Skill {name} already exists.")
            return 1
        target.mkdir(parents=True)
        version = (getattr(args, "version", "") or "").strip() or "1.0.0"
        allowed_tools = (getattr(args, "allowed_tools", "") or "").strip()
        if not description:
            description = f"{name} skill"
        title = name.replace("-", " ").title()
        (target / "SKILL.md").write_text(
            "---\n"
            f"version: {version}\n"
            f"name: {name}\n"
            f"description: {description}\n"
            f"allowed-tools: {allowed_tools}\n"
            f"tags: {tags}\n"
            "---\n\n"
            f"# {title}\n"
        )
        print(f"✅ Skill created: {target}/SKILL.md")
    
    elif kind == "agent":
        target = AICTX_HOME / "agents" / f"{name}.md"
        if target.exists():
            print(f"⚠️  Agent {name} already exists.")
            return 1
        if not description:
            description = f"{name} agent"
        skills = (getattr(args, "skills", "") or "").strip() or "clean-code"
        title = name.replace("-", " ").title()
        target.write_text(
            "---\n"
            f"name: {name}\n"
            f"description: {description}\n"
            f"skills: {skills}\n"
            f"tags: {tags}\n"
            "---\n\n"
            f"# {title}\n"
        )
        print(f"✅ Agent created: {target}")

    return 0


def cmd_archive(args):
    """Move active resources to archived/ so they stop being processed."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    kind = normalize_archivable_type(args.kind) if args.kind else None
    names = [args.name] if args.name else []

    if not kind:
        valid_kinds = [{"name": k, "desc": ""} for k in sorted(ARCHIVABLE_TYPES.keys())]
        selection = TUISelector.select("Select resource type to archive:", valid_kinds)
        if not selection: return 0
        kind = selection[0]["name"]

    if not names:
        resources = scan_resources(AICTX_HOME)
        plural_kind = kind + "s"
        items = sorted(resources.get(plural_kind, []), key=lambda x: x["name"])
        
        if not items:
            print(f"\n⚠️  No active {kind}s found to archive.\n")
            return 0
            
        tui_items = [{"name": i["name"], "desc": i.get("description", "")} for i in items]
        selection = TUISelector.select(f"Select {kind}s to archive (Space to toggle, Enter to confirm):", tui_items, multi=True)
        if not selection: return 0
        names = [s["name"] for s in selection]

    success_count = 0
    for name in names:
        _, active_path, archived_path = build_archivable_paths(AICTX_HOME, kind, name)

        if not active_path.exists():
            print(f"⚠️  {kind} '{name}' is not active, skipping.")
            continue

        archived_path.parent.mkdir(parents=True, exist_ok=True)
        active_path.rename(archived_path)
        print(f"✅ Archived {kind}: {name}")
        success_count += 1

    if success_count > 0:
        print(f"\n💡 {success_count} item(s) archived.")
        print("   Running sync to refresh ALWAYS.md and references...\n")
        return cmd_sync(args)

    return 0


def cmd_unarchive(args):
    """Restore archived resources back to their active folder."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    kind = normalize_archivable_type(args.kind) if args.kind else None
    names = [args.name] if args.name else []

    if not kind:
        valid_kinds = [{"name": k, "desc": ""} for k in sorted(ARCHIVABLE_TYPES.keys())]
        selection = TUISelector.select("Select resource type to restore:", valid_kinds)
        if not selection: return 0
        kind = selection[0]["name"]

    if not names:
        archived = list_archived_items(AICTX_HOME, kind)
        items = sorted(archived.get(kind, []), key=lambda x: x["name"])
        
        if not items:
            print(f"\n⚠️  No archived {kind}s found to restore.\n")
            return 0
            
        selection = TUISelector.select(f"Select {kind}s to restore (Space to toggle, Enter to confirm):", items, multi=True)
        if not selection: return 0
        names = [s["name"] for s in selection]

    success_count = 0
    for name in names:
        _, active_path, archived_path = build_archivable_paths(AICTX_HOME, kind, name)

        if not archived_path.exists():
            print(f"⚠️  {kind} '{name}' is not in archive, skipping.")
            continue

        active_path.parent.mkdir(parents=True, exist_ok=True)
        archived_path.rename(active_path)
        print(f"✅ Restored {kind}: {name}")
        success_count += 1

    if success_count > 0:
        print(f"\n💡 {success_count} item(s) restored.")
        print("   Running sync to refresh ALWAYS.md and references...\n")
        return cmd_sync(args)

    return 0


def cmd_archived(args):
    """List archived resources by type."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    kind = None
    if getattr(args, "kind", None):
        kind = normalize_archivable_type(args.kind)
        if not kind:
            valid = ", ".join(sorted(ARCHIVABLE_TYPES.keys()))
            print(f"\n❌ Unknown type: {args.kind}")
            print(f"   Valid types: {valid}\n")
            return 1

    archived = list_archived_items(AICTX_HOME, kind)

    print("\n🗄️  AI Context — Archived")
    print(f"   Root: {AICTX_HOME / 'archived'}\n")

    total = 0
    for item_kind in sorted(archived.keys()):
        names = archived[item_kind]
        total += len(names)
        print(f"{item_kind}s ({len(names)}):")
        if names:
            for name in names:
                print(f"  - {name}")
        else:
            print("  - (none)")
        print()

    print(f"Total archived items: {total}\n")
    return 0


def cmd_skillscripts(args):
    """List runnable scripts found under skills/*/scripts."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    skill_filter = getattr(args, "skill", None)
    scripts = discover_skill_scripts(AICTX_HOME, skill_filter)

    show_all = bool(getattr(args, "all", False))
    skip_probe = bool(getattr(args, "no_probe", False))

    if skill_filter and skill_filter not in scripts:
        print(f"\n⚠️  No runnable scripts found for skill: {skill_filter}\n")
        return 1

    viable_map: Dict[str, List[Dict[str, str]]] = {}
    blocked_map: Dict[str, List[Dict[str, str]]] = {}

    for skill_name, script_list in scripts.items():
        skill_dir = AICTX_HOME / "skills" / skill_name
        for rel_script in script_list:
            script_path = skill_dir / "scripts" / rel_script
            if skip_probe:
                ready, reason = True, "probe skipped"
            else:
                ready, reason = probe_skill_script(skill_dir, script_path)

            row = {"script": rel_script, "reason": reason}
            if ready:
                viable_map.setdefault(skill_name, []).append(row)
            else:
                blocked_map.setdefault(skill_name, []).append(row)

    total = sum(len(v) for v in viable_map.values())
    blocked_total = sum(len(v) for v in blocked_map.values())
    print("\n🧩 AI Context — Skill Scripts")
    print(f"   Skills with scripts     : {len(scripts)}")
    print(f"   Runnable in one request : {total}")
    print(f"   Blocked/not isolated    : {blocked_total}\n")

    for skill_name in sorted(viable_map.keys()):
        print(f"{skill_name} ({len(viable_map[skill_name])}):")
        for row in viable_map[skill_name]:
            reason = row["reason"]
            if reason == "ok" or reason == "probe skipped":
                print(f"  - {row['script']}")
            else:
                print(f"  - {row['script']}  [{reason}]")
        print()

    if show_all and blocked_total:
        print("Blocked / needs setup:")
        for skill_name in sorted(blocked_map.keys()):
            print(f"{skill_name} ({len(blocked_map[skill_name])}):")
            for row in blocked_map[skill_name]:
                print(f"  - {row['script']}  [{row['reason']}]")
            print()
    elif blocked_total:
        print("Use --all to show blocked scripts and reasons.\n")

    print("Usage:")
    print("  aictx run-skill <skill> <script> [--cwd <path>] [--force] [-- <args...>]\n")
    return 0


def cmd_run_skill(args):
    """Execute a script from a specific skill folder."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    skill = args.skill.strip()
    script = args.script.strip()
    skill_dir = AICTX_HOME / "skills" / skill

    if not skill_dir.exists() or not skill_dir.is_dir():
        print(f"\n❌ Skill not found: {skill}")
        print("   Use: aictx ls skills\n")
        return 1

    script_path = resolve_skill_script(skill_dir, script)
    if not script_path:
        print(f"\n❌ Script not found or ambiguous: {script}")
        print(f"   Skill: {skill}")
        print("   Use: aictx skills-scripts <skill>\n")
        return 1

    script_args = list(args.script_args or [])
    force_run = bool(getattr(args, "force", False))
    if "--force" in script_args:
        force_run = True
        script_args = [arg for arg in script_args if arg != "--force"]

    if script_args and script_args[0] == "--":
        script_args = script_args[1:]

    run_cwd = Path(args.cwd).expanduser().resolve() if args.cwd else Path.cwd()
    if not run_cwd.exists() or not run_cwd.is_dir():
        print(f"\n❌ Invalid cwd: {run_cwd}\n")
        return 1

    command, execution_cwd, build_error = build_skill_script_command(
        skill_dir=skill_dir,
        script_path=script_path,
        script_args=script_args,
        run_cwd=run_cwd,
    )
    if build_error:
        print(f"\n❌ {build_error}\n")
        return 1

    if not force_run:
        ready, reason = probe_skill_script(skill_dir, script_path)
        if not ready:
            print("\n❌ Script is not ready for isolated execution.")
            print(f"   Reason: {reason}")
            print("   Tip   : install dependencies or use --force to try anyway.\n")
            return 1

    print(f"\n▶ Running skill script")
    print(f"   Skill  : {skill}")
    print(f"   Script : {script_path}")
    print(f"   CWD    : {execution_cwd}\n")

    result = subprocess.run(command, cwd=execution_cwd)
    return result.returncode



def _ls_header(emoji: str, title: str, count: int) -> None:
    W = "[1;37m"; C = "[96m"; R = "[0m"; DIM = "[2m"
    line = f"{DIM}{'─' * 56}{R}"
    print(f"\n{line}")
    print(f"  {emoji}  {W}{title}{R}  {C}({count}){R}")
    print(f"{line}")


def _ls_row(name: str, desc: str, badge: str = "", indent: int = 2) -> None:
    G = "\033[1;32m"; Y = "\033[93m"; R = "\033[0m"; DIM = "\033[2m"
    pad = " " * indent
    label = f"{G}{name}{R}"
    badge_txt = f" {Y}{badge}{R}" if badge else ""
    desc_txt = f" {DIM}: {desc}{R}" if desc else ""
    print(f"{pad}{label}{badge_txt}{desc_txt}")
def cmd_ls(args):
    """List available skills, agents, or workflows with descriptions."""
    AICTX_HOME = resolve_aictx_home()
    resources  = scan_resources(AICTX_HOME)
    kind       = getattr(args, "kind", None) or "all"
    C = "[96m"; DIM = "[2m"; R = "[0m"; B = "[1;34m"

    if kind in ("skills", "all"):
        items = sorted(resources["skills"], key=lambda x: x["name"])
        metas = [s for s in items if s.get("tag") == "meta"]
        normals = [s for s in items if s.get("tag") != "meta"]
        _ls_header("🎯", "SKILLS", len(items))

        if metas:
            print(f"\n  {C}always active{R}")
            for s in metas:
                _ls_row(s["name"], s.get("description", ""), badge="[meta]", indent=4)

        if normals:
            print(f"\n  {DIM}domain skills{R}")
            for s in normals:
                _ls_row(s["name"], s.get("description", ""), indent=4)

    if kind in ("agents", "all"):
        items = sorted(resources["agents"], key=lambda x: x["name"])
        _ls_header("🤖", "AGENTS", len(items))
        for a in items:
            skill_list = a.get("skills", "")
            desc = a.get("description", "")
            print()
            _ls_row(a["name"], desc, indent=2)
            if skill_list:
                tags = [t.strip() for t in skill_list.split(",") if t.strip()]
                tag_str = "  ".join(f"{DIM}·{R} {C}{t}{R}" for t in tags)
                print(f"    {tag_str}")

    if kind in ("workflows", "all"):
        items = sorted(resources["workflows"], key=lambda x: x["name"])
        _ls_header("⚡", "WORKFLOWS", len(items))
        for w in items:
            _ls_row(f"/{w['name']}", w.get("description", ""), indent=2)

    W = "[2m"; R = "[0m"
    print(f"\n{W}{'─' * 56}{R}\n")
    return 0


def cmd_init(args):
    """Scaffold a .agent/ context directory in the current (or given) project."""
    AICTX_HOME = resolve_aictx_home()
    from pathlib import Path as _P
    project_dir = _P(args.path).resolve() if getattr(args, "path", None) else _P.cwd()
    agent_dir   = project_dir / ".agent"

    if agent_dir.exists() and not getattr(args, "force", False):
        print(f"\n⚠️  {agent_dir} already exists — use --force to reinit\n")
        return 1

    agent_dir.mkdir(parents=True, exist_ok=True)

    context_file = agent_dir / "CONTEXT.md"
    context_content = (
        "---\n"
        "trigger: always_on\n"
        'applyTo: "**"\n'
        "---\n\n"
        f"# Project Context — {project_dir.name}\n\n"
        "## Stack\n\n"
        "> Describe your tech stack (language, framework, runtime)\n\n"
        "## Key Directories\n\n"
        "> List key dirs and their purpose (e.g. `src/` — app code)\n\n"
        "## Conventions\n\n"
        "> Project-specific rules that override global standards\n\n"
        "## Active Skills\n\n"
        f"> Reference skills from `{AICTX_HOME}/skills/`\n"
        "> Example: prefer `clean-code`, `api-patterns`\n"
    )
    context_file.write_text(context_content)

    print(f"\n🚀 AI Context — Init")
    print(f"   Project : {project_dir.name}")
    print(f"   Dir     : {agent_dir}\n")
    print(f"✅ Created → {context_file}")
    print(f"\n💡 Next steps:")
    print(f"   1. Edit .agent/CONTEXT.md with your project details")
    print(f"   2. Add its path to VS Code settings → chat.instructionsFilesLocations")
    print(f"   3. Or run: aictx install --all\n")
    return 0


def cmd_agents(_args):
    """List all agents with domains and trigger keywords extracted from descriptions."""
    AICTX_HOME = resolve_aictx_home()
    resources = scan_resources(AICTX_HOME)
    agents = sorted(resources["agents"], key=lambda x: x["name"])

    C = "\033[96m"; DIM = "\033[2m"; R = "\033[0m"; B = "\033[1m"
    W = "\033[2m"

    print(f"\n{B}🤖 AGENTS{R}  ({len(agents)} total)\n")
    print(f"  {'Agent':<30} {'Description':<60}")
    print(f"  {'─'*30} {'─'*60}")

    for a in agents:
        name = a["name"]
        desc = a.get("description", "")
        agent_type = a.get("type", "")
        type_badge = f" {DIM}[dir]{R}" if agent_type == "directory" else ""
        # Truncate description for display
        display_desc = desc[:58] + ".." if len(desc) > 60 else desc
        print(f"  {C}{name:<30}{R}{type_badge} {DIM}{display_desc}{R}")

    print(f"\n{W}{'─' * 56}{R}")
    print(f"{DIM}  Tip: See agents/AGENTS.md for full routing table with trigger keywords{R}\n")
    return 0


def cmd_audit(args):
    """Run skill-quality-auditor across all skills and report health scores."""
    AICTX_HOME = resolve_aictx_home()
    skills_dir = AICTX_HOME / "skills"
    auditor_script = skills_dir / "skill-quality-auditor" / "scripts" / "audit_skills.py"

    if not auditor_script.exists():
        print(f"\n❌ Auditor script not found: {auditor_script}")
        print(f"   Make sure the skill-quality-auditor skill is installed.\n")
        return 1

    import subprocess
    target = args.skill if getattr(args, "skill", None) else None
    cmd = ["python3", str(auditor_script)]
    if target:
        cmd += ["--skill", target]
    if getattr(args, "json", False):
        cmd += ["--json"]
    if getattr(args, "output", None):
        cmd += ["--output", args.output]

    print(f"\n🔍 AI Context — Skill Audit")
    print(f"   Source: {skills_dir}\n")

    result = subprocess.run(cmd, cwd=str(AICTX_HOME))
    return result.returncode


def cmd_context(args):
    """Manage AI context enable/disable state with TUI."""
    action = args.action if hasattr(args, "action") and args.action else None
    
    if not action:
        state = read_context_state()
        current = "ENABLED" if state.get("context_enabled", True) else "DISABLED"
        
        options = [
            {"name": "status",  "desc": f"Show current state (currently {current})"},
            {"name": "enable",  "desc": "Activate context processing for all AI tools"},
            {"name": "disable", "desc": "Deactivate context to save tokens/focus"},
            {"name": "toggle",  "desc": "Switch between enable and disable"},
        ]
        
        selection = TUISelector.select("AI Context Management:", options)
        if not selection: return 0
        action = selection[0]["name"]

    if action == "enable":
        state = read_context_state()
        state["context_enabled"] = True
        write_context_state(state)
        print("\n✅ AI Context — ENABLED")
        print("   Context will be processed by AI tools (skills, agents, rules, workflows)")
        print("   Run 'aictx sync' to regenerate ALWAYS.md\n")
        
    elif action == "disable":
        state = read_context_state()
        state["context_enabled"] = False
        write_context_state(state)
        print("\n⏸️  AI Context — DISABLED")
        print("   AI tools will not process context from ~/.ai-context")
        print("   This saves token consumption when focusing on pure AI processing")
        print("   Run 'aictx sync' to regenerate ALWAYS.md\n")
        
    elif action == "toggle":
        state = read_context_state()
        current = state.get("context_enabled", True)
        state["context_enabled"] = not current
        write_context_state(state)
        new_state = "ENABLED" if state["context_enabled"] else "DISABLED"
        print(f"\n🔄 AI Context — {new_state}")
        print("   Run 'aictx sync' to regenerate ALWAYS.md\n")
        
    elif action == "status":
        state = read_context_state()
        current = state.get("context_enabled", True)
        status_str = "✅ ENABLED" if current else "⏸️  DISABLED"
        print(f"\n{status_str}\n")
        if current:
            print("   Context is active. AI tools will process skills, agents, rules, and workflows.")
        else:
            print("   Context is inactive. AI tools will not process context from ~/.ai-context.")
            print("   Use 'aictx context enable' to re-enable.")
        print()
    return 0


def cmd_test(args):
    """Run regression tests on all aictx commands."""
    print_header("🧪", "AI Context — Regression Suite", "Validating all commands...")
    
    tests = [
        ("status", "aictx status", "Check UI and injection status"),
        ("sync", "aictx sync", "Validate manifest generation"),
        ("ls", "aictx ls", "List all resources"),
        ("agents", "aictx agents", "List agents specifically"),
        ("config", "aictx config", "Check paths and environment"),
        ("doctor", "aictx doctor", "Run integrity check"),
        ("archive-test", "aictx archived", "Verify archive access"),
    ]

    passed = 0
    for i, (name, cmd, desc) in enumerate(tests):
        print(f"\n[{i+1}/{len(tests)}] {B}{name.upper()}{RES} — {desc}")
        try:
            # We run the commands via subprocess to capture output and return codes
            res = subprocess.run(cmd.split(), capture_output=True, text=True)
            if res.returncode == 0:
                print_step(True, f"Command '{cmd}' executed successfully")
                passed += 1
            else:
                print_step(False, f"Command '{cmd}' failed (Code {res.returncode})", res.stderr.strip())
        except Exception as e:
            print_step(False, f"Execution error: {str(e)}")

    print(f"\n{B}📊 TEST SUMMARY{RES}")
    print(f"   Passed: {G}{passed}/{len(tests)}{RES}")
    
    if passed == len(tests):
        print(f"\n✨ {G}All systems normal!{RES} Quality and functionality validated.\n")
    else:
        print(f"\n⚠️  {Y}Some tests failed.{RES} Check logs above for details.\n")
    
    return 0 if passed == len(tests) else 1


def main():
    parser = argparse.ArgumentParser(
        prog="aictx",
        description=f"{B}AI Context CLI{RES} — Manage AI resource links and sync {B}ALWAYS.md{RES}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
{B}EXAMPLES:{RES}
  aictx status           Show link status and resource counts
  aictx sync             Regenerate ALWAYS.md and refresh links
  aictx install          Interactive TUI to install links
  aictx ls               List all resources (skills, agents, etc.)
  aictx add skill name   Scaffold a new skill
  aictx doctor --fix     Validate and auto-fix resource integrity
  aictx test             Run regression tests
        """
    )

    sub = parser.add_subparsers(dest="command")
    sub.add_parser("test", help="Run regression tests on all commands").set_defaults(func=cmd_test)
    sub.add_parser("sync",      help="Scan resources and regenerate ALWAYS.md").set_defaults(func=cmd_sync)
    p_doctor = sub.add_parser("doctor", help="Validate integrity of ai-context resources")
    p_doctor.add_argument("--fix", action="store_true", help="Auto-fix missing resource files or orphan references")
    p_doctor.set_defaults(func=cmd_doctor)

    p_context = sub.add_parser("context", help="Enable/disable AI context processing")
    p_context.add_argument("action", nargs="?", choices=["enable", "disable", "toggle", "status"], help="Context action")
    p_context.set_defaults(func=cmd_context)

    p_add = sub.add_parser("add", help="Scaffold a new skill or agent")
    p_add.add_argument("kind", nargs="?", choices=["skill", "agent"], help="What to create")
    p_add.add_argument("name", nargs="?", help="Name of the skill or agent (e.g. my-skill)")
    p_add.add_argument("--description", "-d", help="Short description")
    p_add.add_argument("--version", "-v", help="Skill version (skills only)")
    p_add.add_argument("--tags", "-t", help="Comma-separated tags")
    p_add.add_argument("--allowed-tools", dest="allowed_tools", help="Comma-separated allowed tool names (skills only)")
    p_add.add_argument("--skills", "-s", help="Comma-separated skill refs (agents only)")
    p_add.set_defaults(func=cmd_add)

    p_archive = sub.add_parser("archive", help="Archive a skill/rule/agent/workflow/spec")
    p_archive.add_argument("kind", nargs="?", help="Type: skill, rule, agent, workflow, spec")
    p_archive.add_argument("name", nargs="?", help="Resource name (without .md)")
    p_archive.set_defaults(func=cmd_archive)

    p_unarchive = sub.add_parser("unarchive", help="Restore an archived skill/rule/agent/workflow/spec")
    p_unarchive.add_argument("kind", nargs="?", help="Type: skill, rule, agent, workflow, spec")
    p_unarchive.add_argument("name", nargs="?", help="Resource name (without .md)")
    p_unarchive.set_defaults(func=cmd_unarchive)

    p_archived = sub.add_parser("archived", help="List archived resources")
    p_archived.add_argument("kind", nargs="?", help="Optional type filter")
    p_archived.set_defaults(func=cmd_archived)

    p_skill_scripts = sub.add_parser("skills-scripts", help="List runnable scripts from skills")
    p_skill_scripts.add_argument("skill", nargs="?", help="Optional skill filter")
    p_skill_scripts.add_argument("--all", action="store_true", help="Also show blocked scripts with reasons")
    p_skill_scripts.add_argument("--no-probe", action="store_true", help="Skip runtime viability probing")
    p_skill_scripts.set_defaults(func=cmd_skillscripts)

    # Backward compatible alias (deprecated)
    p_skill_scripts_legacy = sub.add_parser("skillscripts", help="Alias of skills-scripts (deprecated)")
    p_skill_scripts_legacy.add_argument("skill", nargs="?", help="Optional skill filter")
    p_skill_scripts_legacy.add_argument("--all", action="store_true", help="Also show blocked scripts with reasons")
    p_skill_scripts_legacy.add_argument("--no-probe", action="store_true", help="Skip runtime viability probing")
    p_skill_scripts_legacy.set_defaults(func=cmd_skillscripts)

    p_run_skill = sub.add_parser("run-skill", help="Run a script from a skill")
    p_run_skill.add_argument("skill", help="Skill folder name")
    p_run_skill.add_argument("script", help="Script file name (or stem)")
    p_run_skill.add_argument("--cwd", help="Execution working directory (default: current dir)")
    p_run_skill.add_argument("--force", action="store_true", help="Run even if isolation probe fails")
    p_run_skill.add_argument("script_args", nargs=argparse.REMAINDER, help="Arguments passed to the skill script")
    p_run_skill.set_defaults(func=cmd_run_skill)

    sub.add_parser("status",    help="Show link status").set_defaults(func=cmd_status)
    sub.add_parser("uninstall", help="Remove all managed links").set_defaults(func=cmd_uninstall)
    sub.add_parser("config",    help="Show configuration").set_defaults(func=cmd_config)
    sub.add_parser("agents",    help="List agents with descriptions (routing quick-reference)").set_defaults(func=cmd_agents)

    p_audit = sub.add_parser("audit", help="Run skill-quality-auditor across all skills")
    p_audit.add_argument("skill", nargs="?", help="Audit a single skill by name (default: all)")
    p_audit.add_argument("--json", action="store_true", help="Output results as JSON")
    p_audit.add_argument("--output", help="Save report to a file path")
    p_audit.set_defaults(func=cmd_audit)

    p_ls = sub.add_parser("ls", help="List available skills, agents, or workflows")
    p_ls.add_argument("kind", nargs="?", choices=["skills", "agents", "workflows"], help="What to list (default: all)")
    p_ls.set_defaults(func=cmd_ls)

    p_init = sub.add_parser("init", help="Scaffold a .agent/ context dir in the current project")
    p_init.add_argument("path", nargs="?", help="Project path (default: current directory)")
    p_init.add_argument("--force", action="store_true", help="Reinit even if .agent/ exists")
    p_init.set_defaults(func=cmd_init)

    p_install = sub.add_parser("install", help="Install resource links to AI tools")
    p_install.add_argument("--all",   action="store_true", help="Install all targets and resources")
    p_install.add_argument("--force", action="store_true", help="Overwrite existing links")
    p_install.set_defaults(func=cmd_install)

    p_telemetry = sub.add_parser("telemetry", help="Analyze context-read telemetry from chat/debug logs")
    p_telemetry.add_argument("path", nargs="?", help="Log file or folder path (defaults to latest Copilot debug log)")
    p_telemetry.add_argument("--json", action="store_true", help="Output JSON to stdout")
    p_telemetry.add_argument("--output", help="Save JSON report to a file path")
    p_telemetry.add_argument("--top-files", type=int, default=10, help="Number of top-read files to show (default: 10)")
    p_telemetry.set_defaults(func=cmd_telemetry)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return

    args.func(args)


if __name__ == "__main__":
    sys.exit(main())

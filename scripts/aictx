    },
    "spec": {
        "active_dir": "specs",
        "archived_dir": "specs",
        "active_pattern": "{name}.md",
    },
}

ARCHIVABLE_ALIASES = {
    "skills": "skill",
    "rules": "rule",
    "agents": "agent",
    "workflows": "workflow",
    "specs": "spec",
    "espec": "spec",
    "especs": "spec",
}

RUNNABLE_SCRIPT_EXTS = {".py", ".sh", ".js"}

RUNTIME_DIRNAME = ".aictx-runtime"
CONTEXT_SIZES_FILENAME = ".context-sizes.json"
RESOURCES_MANIFEST_FILENAME = ".aictx-manifest.json"

TARGETS = {
    "copilot": {
        "description": "VS Code Copilot (User Profile instructions + settings)",
        "link_type": "copilot",

#!/usr/bin/env python3
"""
aictx — AI Context CLI

Manages symbolic links from ~/.ai-context resources to AI tools
(Copilot, Claude Code, Gemini, etc.) and keeps ALWAYS.md in sync.

Commands:
  aictx sync              Scan resources and regenerate ALWAYS.md
  aictx context           Enable/disable/toggle/status of AI context processing
  aictx install           Interactive installation of links
  aictx install --all     Install all targets and resources
  aictx install --force   Overwrite existing links
  aictx telemetry         Analyze context-read telemetry from logs
  aictx skills-scripts    List runnable scripts available in skills
  aictx run-skill         Execute a skill script
  aictx status            Show current link/resource status
  aictx uninstall         Remove all managed links
  aictx config            Show current configuration
"""

import os
import sys
import json
import re
import argparse
import platform
import subprocess
import shutil
from collections import Counter, defaultdict
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Optional

HOME = Path.home()
AICTX_HOME = Path(os.environ.get("AICTX_HOME", HOME / ".ai-context"))
STATE_FILE = AICTX_HOME / ".aictx_state.json"
RESOURCES = ["rules", "skills", "agents", "workflows", "specs"]

# --- ANSI Colors ---
B   = "\033[1m"
C   = "\033[96m"
G   = "\033[92m"
Y   = "\033[93m"
RED = "\033[31m"
R   = RED  # Alias for compatibility
RES = "\033[0m"
DIM = "\033[2m"

def print_header(emoji: str, title: str, subtitle: str = None):
    print(f"\n{emoji} {B}{title}{RES}")
    if subtitle:
        print(f"   {DIM}{subtitle}{RES}")
    print()

def print_section(title: str):
    print(f" {B}{title}{RES}")

def print_step(success: bool, label: str, details: str = ""):
    icon = f"{G}✓{RES}" if success else f"{R}✗{RES}"
    details_str = f" {DIM}→ {details}{RES}" if details else ""
    print(f"   {icon} {label}{details_str}")

ARCHIVABLE_TYPES = {
    "skill": {
        "active_dir": "skills",

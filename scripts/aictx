def resolve_aictx_home() -> Path:
    return Path(__file__).resolve().parent.parent


def read_context_state() -> dict:
    """Read the current context state from .aictx_state.json."""
    global STATE_FILE
    if not STATE_FILE.exists():
        return {"context_enabled": True}
    try:
        return json.load(open(STATE_FILE))
    except Exception:
        return {"context_enabled": True}


def write_context_state(state: dict) -> None:
    """Write the context state to .aictx_state.json."""
    global STATE_FILE
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def is_context_enabled() -> bool:
    """Check if the AI context is enabled."""
    state = read_context_state()
    return state.get("context_enabled", True)


class TUISelector:
    """A premium terminal-based selector with arrow navigation and multi-selection."""
    
    @staticmethod
    def select(title: str, items: List[dict], multi: bool = False) -> List[dict]:
        """items should be a list of dicts: {"name": "...", "desc": "..."}"""
        if not items: return []

        import tty, termios
        G = "\033[92m"; Y = "\033[93m"; C = "\033[96m"; R = "\033[0m"; B = "\033[1m"; DIM = "\033[2m"
        HIDE = "\033[?25l"; SHOW = "\033[?25h"
        
        selected_indices = set()
        current_index = 0
        lines_written = 0

        def render():
            nonlocal lines_written
            # Move up and clear previous lines
            if lines_written > 0:
                sys.stdout.write(f"\033[{lines_written}F\033[J")
            
            output = []
            output.append(f" {B}{title}{R}")
            output.append(f" {DIM}{'─' * (len(title)+2)}{R}")
            
            for i, item in enumerate(items):
                cursor = f"{C}❯{R}" if i == current_index else " "
                name = item["name"]
                desc = item.get("desc", "")
                desc_str = f" {DIM}— {desc[:70]}{R}" if desc else ""
                
                if multi:
                    box = f"{G}[x]{R}" if i in selected_indices else "[ ]"
                    label = f"{B}{name}{R}" if i == current_index else name
                    output.append(f" {cursor} {box} {label}{desc_str}")
                else:
                    label = f"{C}{B}{name}{R}" if i == current_index else name
                    output.append(f" {cursor} {label}{desc_str}")
            
            output.append(f"\n {DIM}↑/↓: Navigate | Space: Toggle | Enter: Confirm{R}")
            if multi:
                output.append(f" {DIM}S: Select All | D: Deselect All | I: Invert | Q: Abort{R}")
            else:
                output.append(f" {DIM}Q: Abort{R}")
            
            final_output = "\n".join(output) + "\n"
            lines_written = final_output.count("\n")
            sys.stdout.write(final_output)
            sys.stdout.flush()

        sys.stdout.write(HIDE)
        sys.stdout.flush()

        def get_key():
            fd = sys.stdin.fileno()
            old_settings = termios.tcgetattr(fd)
            try:
                tty.setraw(fd)
                ch = sys.stdin.read(1)
                if ch == '\x1b':
                    ch += sys.stdin.read(2)
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            return ch

        try:
            while True:
                render()
                key = get_key()
                key_l = key.lower()
                if key == '\x1b[A': current_index = (current_index - 1) % len(items)
                elif key == '\x1b[B': current_index = (current_index + 1) % len(items)
                elif key == ' ' and multi:
                    if current_index in selected_indices: selected_indices.remove(current_index)
                    else: selected_indices.add(current_index)
                elif multi and key_l in ('a', 's'): selected_indices = set(range(len(items)))
                elif multi and key_l in ('n', 'd'): selected_indices = set()
                elif multi and key_l == 'i':
                    selected_indices = set(range(len(items))) - selected_indices
                elif key == '\r':
                    if multi: return [items[i] for i in sorted(selected_indices)]
                    return [items[current_index]]
                elif key_l in ('q', '\x03'): return []
        finally:
            # Clear the TUI before exiting
            if lines_written > 0:
                sys.stdout.write(f"\033[{lines_written}F\033[J")
            sys.stdout.write(SHOW)
            sys.stdout.flush()


def get_runtime_paths(aictx_home: Path) -> Dict[str, Path]:
    runtime_root = aictx_home / RUNTIME_DIRNAME
    return {
        "root": runtime_root,
        "active": runtime_root / "active",
        "disabled": runtime_root / "disabled",
        "current": runtime_root / "current",
    }


def build_disabled_always_stub() -> str:
    return (
        "---\n"
        "trigger: always_on\n"
        'applyTo: "**"\n'
        "---\n\n"
        "# AI CONTEXT — DISABLED\n\n"
        "> **AI Context is currently DISABLED.**\n"
        "> Use `aictx context enable` to re-enable it.\n\n"
        "To re-enable processing of skills, agents, rules, and workflows, run:\n\n"
        "```bash\naictx context enable\n```\n\n"
        "**Note:** While disabled, AI tools will not process any context from ~/.ai-context.\n"
        "This allows you to focus on pure AI processing without token consumption from loaded context.\n"
    )


def ensure_symlink(src: Path, dst: Path) -> None:
    try:
        if dst.is_symlink() and dst.resolve() == src.resolve():
            return
    except Exception:
        pass

    if dst.exists() or dst.is_symlink():
        if dst.is_dir() and not dst.is_symlink():
            shutil.rmtree(dst)
        else:
            dst.unlink()

    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.symlink_to(src)


def ensure_runtime_tree(aictx_home: Path) -> Path:
    paths = get_runtime_paths(aictx_home)
    active_root = paths["active"]
    disabled_root = paths["disabled"]
    current_root = paths["current"]

    active_root.mkdir(parents=True, exist_ok=True)
    disabled_root.mkdir(parents=True, exist_ok=True)

    for resource in RESOURCES:
        src = aictx_home / resource
        dst = active_root / resource
        ensure_symlink(src, dst)

    for resource in RESOURCES:
        dst = disabled_root / resource
        dst.mkdir(parents=True, exist_ok=True)
        if resource == "rules":
            disabled_always = dst / "ALWAYS.md"
            disabled_always.write_text(build_disabled_always_stub())

    target_root = active_root if is_context_enabled() else disabled_root
    ensure_symlink(target_root, current_root)
    return current_root


def resolve_context_root(aictx_home: Path) -> Path:
    paths = get_runtime_paths(aictx_home)
    current_root = paths["current"]
    if current_root.exists():
        return current_root
    return aictx_home


def migrate_folder_links_to_context_root(context_root: Path) -> None:
    for target in TARGETS.values():
        if target.get("link_type") != "folders":
            continue
        base = target["base"]
        if not base.exists():
            continue
        for resource in RESOURCES:
            dst = base / resource
            if not dst.is_symlink():
                continue
            try:
                resolved = dst.resolve()
            except Exception:
                resolved = None

            expected = context_root / resource
            try:
                expected_resolved = expected.resolve()
            except Exception:
                expected_resolved = expected

            if resolved and resolved == expected_resolved:
                continue

            if resolved and str(resolved).startswith(str(AICTX_HOME)):
                ensure_symlink(expected, dst)


def maybe_update_vscode_settings_paths(context_root: Path) -> None:
    settings_path = HOME / ".config/Code/User/settings.json"
    if not settings_path.exists():
        return

    try:
        data = parse_jsonc(settings_path.read_text())
    except Exception:
        return

    locations = data.get("chat.instructionsFilesLocations", {})
    if not locations:
        return

    has_aictx = False
    for resource in RESOURCES:
        legacy_abs = str(AICTX_HOME / resource)
        legacy_tilde = legacy_abs.replace(str(HOME), "~")
        current_abs = str(context_root / resource)
        current_tilde = current_abs.replace(str(HOME), "~")
        if legacy_abs in locations or legacy_tilde in locations:
            has_aictx = True
            break
        if current_abs in locations or current_tilde in locations:
            has_aictx = True
            break

    if has_aictx:
        update_vscode_settings_paths(settings_path, RESOURCES, context_root)


def update_folder_global_rules(context_root: Path, content: str) -> None:
    for target in TARGETS.values():
        if target.get("link_type") != "folders":
            continue
        global_rule_path = target.get("global_rule")
        if not global_rule_path:
            continue
        if not global_rule_path.parent.exists():
            continue
        try:
            global_rule_path.write_text(content)
            print(f"✅ {global_rule_path.name} updated → {global_rule_path}")
        except Exception as e:
            print(f"⚠  Could not update {global_rule_path.name}: {e}")


def _file_size_kb(path: Path) -> float:
    try:
        return round(path.stat().st_size / 1024, 1)
    except Exception:
        return 0.0


def build_context_sizes_manifest(context_root: Path) -> dict:
    rules_dir = context_root / "rules"
    skills_dir = context_root / "skills"
    agents_dir = context_root / "agents"
    workflows_dir = context_root / "workflows"

    rules = {}
    if rules_dir.exists():
        for md_file in sorted(rules_dir.glob("*.md")):
            rules[md_file.stem] = _file_size_kb(md_file)

    skills = {}
    meta_skills = []
    if skills_dir.exists():
        for skill_dir in sorted(p for p in skills_dir.iterdir() if p.is_dir()):
            skill_file = next(
                (skill_dir / fn for fn in ["SKILL.md", "skill.md"] if (skill_dir / fn).exists()), None
            )
            if not skill_file:
                continue
            skills[skill_dir.name] = _file_size_kb(skill_file)
            fm = read_frontmatter(skill_file)
            if fm.get("tag") == "meta":
                meta_skills.append(skill_dir.name)

    agents = {}
    if agents_dir.exists():
        for md_file in sorted(agents_dir.glob("*.md")):
            agents[md_file.stem] = _file_size_kb(md_file)

    workflows = {}
    if workflows_dir.exists():
        for md_file in sorted(workflows_dir.glob("*.md")):
            workflows[md_file.stem] = _file_size_kb(md_file)

    rules_kb = round(sum(rules.values()), 1)
    meta_kb = round(sum(skills.get(name, 0.0) for name in meta_skills), 1)
    baseline_kb = round(rules_kb + meta_kb, 1)

    return {
        "schemaVersion": 1,
        "generatedAt": datetime.now().isoformat(timespec="seconds"),
        "contextEnabled": is_context_enabled(),
        "contextRoot": str(context_root),
        "units": "KB",
        "thresholds": {"safe": 40, "warn": 80, "block": 80},
        "baseline": {
            "rules_kb": rules_kb,
            "meta_skills_kb": meta_kb,
            "total_kb": baseline_kb,
            "meta_skills": sorted(meta_skills),
        },
        "rules": rules,
        "skills": skills,
        "agents": agents,
        "workflows": workflows,
    }


def write_context_sizes_manifest(context_root: Path, output_path: Path) -> None:
    manifest = build_context_sizes_manifest(context_root)
    output_path.write_text(json.dumps(manifest, indent=2) + "\n")


def _split_csv(value: str) -> List[str]:
    if not value:
        return []
    v = value.strip()
    if v.startswith("[") and v.endswith("]"):
        v = v[1:-1]
    parts = re.split(r"[,|]", v)
    return [p.strip() for p in parts if p and p.strip()]


def build_resources_manifest(context_root: Path, resources: dict) -> dict:
    """Build a machine-readable manifest for rules/skills/agents/workflows/specs.

    Intended for prompt-middleware features like Smart Tags, context ranking,
    and token budgeting.
    """
    root = context_root

    def _with_size(item: dict, path: Path) -> dict:
        out = dict(item)
        out["size_kb"] = _file_size_kb(path) if path.exists() else 0.0
        out["tags_list"] = _split_csv(out.get("tags", ""))
        return out

    rules_dir = root / "rules"
    skills_dir = root / "skills"
    agents_dir = root / "agents"
    workflows_dir = root / "workflows"
    specs_dir = root / "specs"

    rules = [_with_size(r, rules_dir / f"{r['name']}.md") for r in resources.get("rules", [])]
    skills = [_with_size(s, skills_dir / s["name"] / "SKILL.md") for s in resources.get("skills", [])]

    agents = []
    for a in resources.get("agents", []):
        if a.get("type") == "directory":
            p = agents_dir / a["name"] / "agent.md"
        else:
            p = agents_dir / f"{a['name']}.md"
        agents.append(_with_size(a, p))

    workflows = [_with_size(w, workflows_dir / f"{w['name']}.md") for w in resources.get("workflows", [])]
    specs = [_with_size(sp, specs_dir / f"{sp['name']}.md") for sp in resources.get("specs", [])]

    return {
        "schemaVersion": 1,
        "generatedAt": datetime.now().isoformat(timespec="seconds"),
        "contextEnabled": is_context_enabled(),
        "contextRoot": str(root),
        "rules": rules,
        "skills": skills,
        "agents": agents,
        "workflows": workflows,
        "specs": specs,
    }


def write_resources_manifest(context_root: Path, resources: dict, output_path: Path) -> None:
    manifest = build_resources_manifest(context_root, resources)
    output_path.write_text(json.dumps(manifest, indent=2) + "\n")


def read_frontmatter(filepath: Path) -> dict:
    data = {}
    try:
        content = filepath.read_text()
        if not content.startswith("---"):
            return data
        lines = content.split("\n")
        in_front = False
        for line in lines:
            if line.strip() == "---":
                if not in_front:
                    in_front = True
                    continue
                else:
                    break
            if in_front and ":" in line:
                key, _, value = line.partition(":")
                data[key.strip()] = value.strip().strip('"')
    except Exception:
        pass
    return data


def scan_resources(aictx_home: Path) -> dict:
    result = {"rules": [], "skills": [], "agents": [], "workflows": [], "specs": []}

    rules_dir = aictx_home / "rules"
    if rules_dir.exists():
        for f in sorted(rules_dir.glob("*.md")):
            if f.stem.lower() in ("always", "always_md"):
                continue
            fm = read_frontmatter(f)
            result["rules"].append({
                "name": f.stem,
                "file": f.name,
                "priority": fm.get("priority", "P0"),
                "trigger": fm.get("trigger", "always_on"),
                "description": fm.get("description", ""),
                "tags": fm.get("tags", ""),
            })

    skills_dir = aictx_home / "skills"
    if skills_dir.exists():
        for d in sorted(skills_dir.iterdir()):
            if d.is_dir():
                skill_file = next(
                    (d / fn for fn in ["SKILL.md", "skill.md"] if (d / fn).exists()), None
                )
                if skill_file:
                    fm = read_frontmatter(skill_file)
                    result["skills"].append({
                        "name": d.name,
                        "tag": fm.get("tag", ""),
                        "description": fm.get("description", ""),
                        "version": fm.get("version", ""),
                        "tags": fm.get("tags", ""),
                        "allowed_tools": fm.get("allowed-tools", ""),
                    })

    agents_dir = aictx_home / "agents"
    if agents_dir.exists():
        _AGENTS_EXCLUDE = {"agents", "readme", "index", "template"}
        for f in sorted(agents_dir.glob("*.md")):
            if f.stem.startswith("_") or f.stem.lower() in _AGENTS_EXCLUDE:
                continue  # skip _TEMPLATE.md, AGENTS.md, and similar internal files
            fm = read_frontmatter(f)
            result["agents"].append({
                "name": f.stem,
                "description": fm.get("description", ""),
                "skills": fm.get("skills", ""),
                "tags": fm.get("tags", ""),
            })
        # Also detect directory-based agents (e.g. agent-name/agent.md)
        for d in sorted(agents_dir.iterdir()):
            if d.is_dir() and not d.name.startswith("_"):
                agent_file = d / "agent.md"
                if agent_file.exists():
                    fm = read_frontmatter(agent_file)
                    result["agents"].append({
                        "name": d.name,
                        "description": fm.get("description", ""),
                        "skills": fm.get("skills", ""),
                        "tags": fm.get("tags", ""),
                        "type": "directory",
                    })

    workflows_dir = aictx_home / "workflows"
    if workflows_dir.exists():
        for f in sorted(workflows_dir.glob("*.md")):
            fm = read_frontmatter(f)
            result["workflows"].append({
                "name": f.stem,
                "description": fm.get("description", ""),
                "tags": fm.get("tags", ""),
            })

    specs_dir = aictx_home / "specs"
    if specs_dir.exists():
        for f in sorted(specs_dir.glob("*.md")):
            if f.name == ".gitkeep":
                continue
            fm = read_frontmatter(f)
            result["specs"].append({
                "name": f.stem,
                "description": fm.get("description", ""),
                "version": fm.get("version", ""),
                "tags": fm.get("tags", ""),
            })

    return result


def normalize_archivable_type(kind: str) -> Optional[str]:
    if not kind:
        return None
    lowered = kind.strip().lower()
    if lowered in ARCHIVABLE_TYPES:
        return lowered
    return ARCHIVABLE_ALIASES.get(lowered)


def build_archivable_paths(aictx_home: Path, kind: str, name: str):
    conf = ARCHIVABLE_TYPES[kind]
    normalized_name = name.strip()
    if normalized_name.endswith(".md"):
        normalized_name = normalized_name[:-3]

    active_rel = Path(conf["active_dir"]) / conf["active_pattern"].format(name=normalized_name)
    active_path = aictx_home / active_rel

    archived_base = aictx_home / "archived" / conf["archived_dir"]
    archived_path = archived_base / active_rel.name
    return normalized_name, active_path, archived_path


def list_archived_items(aictx_home: Path, kind: Optional[str] = None) -> Dict[str, List[dict]]:
    result: Dict[str, List[dict]] = {}
    kinds = [kind] if kind else sorted(ARCHIVABLE_TYPES.keys())

    for item_kind in kinds:
        conf = ARCHIVABLE_TYPES[item_kind]
        archived_dir = aictx_home / "archived" / conf["archived_dir"]
        items: List[dict] = []

        if archived_dir.exists():
            if item_kind == "skill":
                for entry in sorted(archived_dir.iterdir()):
                    if entry.is_dir():
                        skill_file = next((entry / fn for fn in ["SKILL.md", "skill.md"] if (entry / fn).exists()), None)
                        desc = ""
                        if skill_file:
                            desc = read_frontmatter(skill_file).get("description", "")
                        items.append({"name": entry.name, "desc": desc})
            else:
                for entry in sorted(archived_dir.glob("*.md")):
                    desc = read_frontmatter(entry).get("description", "")
                    items.append({"name": entry.stem, "desc": desc})

        result[item_kind] = items

    return result


def discover_skill_scripts(aictx_home: Path, skill_name: Optional[str] = None) -> Dict[str, List[str]]:
    skills_dir = aictx_home / "skills"
    result: Dict[str, List[str]] = {}

    if not skills_dir.exists():
        return result

    candidates = [skills_dir / skill_name] if skill_name else sorted(p for p in skills_dir.iterdir() if p.is_dir())

    for skill_dir in candidates:
        if not skill_dir.exists() or not skill_dir.is_dir():
            continue

        scripts_dir = skill_dir / "scripts"
        if not scripts_dir.exists() or not scripts_dir.is_dir():
            continue

        scripts: List[str] = []
        for path in sorted(scripts_dir.rglob("*")):
            if not path.is_file():
                continue
            if "__pycache__" in path.parts:
                continue
            if path.name == "__init__.py" or path.name.startswith("_"):
                continue
            if path.suffix.lower() not in RUNNABLE_SCRIPT_EXTS:
                continue
            if path.suffix.lower() == ".py":
                try:
                    text = path.read_text(errors="ignore")
                except Exception:
                    continue
                if 'if __name__ == "__main__":' not in text and "if __name__ == '__main__':" not in text:
                    continue
            scripts.append(str(path.relative_to(scripts_dir)))

        if scripts:
            result[skill_dir.name] = scripts

    return result


def resolve_skill_script(skill_dir: Path, script_name: str) -> Optional[Path]:
    scripts_dir = skill_dir / "scripts"
    if not scripts_dir.exists():
        return None

    requested = script_name.strip()
    if not requested:
        return None
    if ".." in Path(requested).parts:
        return None

    direct = scripts_dir / requested
    if direct.exists() and direct.is_file():
        resolved = direct.resolve()
        if scripts_dir.resolve() in resolved.parents:
            return resolved
        return None

    stem = Path(requested).stem
    matches: List[Path] = []
    for candidate in scripts_dir.rglob("*"):
        if not candidate.is_file():
            continue
        if candidate.suffix.lower() not in RUNNABLE_SCRIPT_EXTS:
            continue
        if candidate.name == "__init__.py" or candidate.name.startswith("_"):
            continue
        if "__pycache__" in candidate.parts:
            continue
        if candidate.suffix.lower() == ".py":
            try:
                text = candidate.read_text(errors="ignore")
            except Exception:
                continue
            if 'if __name__ == "__main__":' not in text and "if __name__ == '__main__':" not in text:
                continue
        if candidate.stem == stem or candidate.name == requested:
            matches.append(candidate.resolve())

    if len(matches) == 1:
        return matches[0]

    return None


def build_skill_script_command(skill_dir: Path, script_path: Path, script_args: List[str], run_cwd: Path):
    ext = script_path.suffix.lower()
    if ext == ".py":
        scripts_pkg = (skill_dir / "scripts" / "__init__.py").exists()
        if scripts_pkg:
            module = f"scripts.{script_path.stem}"
            command = [sys.executable, "-m", module, *script_args]
            execution_cwd = skill_dir
        else:
            command = [sys.executable, str(script_path), *script_args]
            execution_cwd = run_cwd
        return command, execution_cwd, None

    if ext == ".sh":
        if not shutil.which("bash"):
            return None, None, "bash not available in PATH"
        return ["bash", str(script_path), *script_args], run_cwd, None

    if ext == ".js":
        if not shutil.which("node"):
            return None, None, "node not available in PATH"
        return ["node", str(script_path), *script_args], run_cwd, None

    return None, None, f"unsupported script type: {script_path.suffix}"


def probe_skill_script(skill_dir: Path, script_path: Path) -> (bool, str):
    """Return viability for isolated execution and a reason string."""
    def run_probe_with_args(probe_args: List[str]):
        command, execution_cwd, build_error = build_skill_script_command(
            skill_dir=skill_dir,
            script_path=script_path,
            script_args=probe_args,
            run_cwd=skill_dir.parent.parent,
        )
        if build_error:
            return None, build_error

        try:
            proc = subprocess.run(
                command,
                cwd=execution_cwd,
                capture_output=True,
                text=True,
                timeout=10,
            )
        except subprocess.TimeoutExpired:
            return None, "timed out during probe"
        except Exception as exc:
            return None, f"probe failed: {exc}"

        output = (proc.stdout or "") + "\n" + (proc.stderr or "")
        lowered = output.lower()

        if proc.returncode == 0:
            return True, "ok"

        if proc.returncode == 2 and ("usage:" in lowered or "--help" in lowered):
            return True, "requires positional args (but runnable)"

        if "usage:" in lowered and "modulenotfounderror" not in lowered and "no module named" not in lowered:
            return True, "requires explicit args (but runnable)"

        if "modulenotfounderror" in lowered or "no module named" in lowered:
            missing = "unknown module"
            match = re.search(r"No module named ['\"]([^'\"]+)['\"]", output)
            if match:
                missing = match.group(1)
            return False, f"missing python dependency: {missing}"

        if "command not found" in lowered:
            return False, "required runtime command not found"

        if "playwright" in lowered:
            return False, "requires playwright/browser deps"

        return False, f"non-zero exit during probe ({proc.returncode})"

    first_ok, first_reason = run_probe_with_args(["--help"])
    if first_ok is True:
        return True, first_reason
    if first_ok is None:
        return False, first_reason
    if first_reason.startswith("missing ") or "runtime command" in first_reason:
        return False, first_reason

    second_ok, second_reason = run_probe_with_args([])
    if second_ok is True:
        return True, second_reason
    if second_ok is None:
        return False, second_reason
    if second_reason.startswith("missing ") or "runtime command" in second_reason:
        return False, second_reason

    return False, second_reason


def build_bootstrap_block() -> str:
    """Minimal session bootstrap — just confirms AI Context is active."""
    return """## 🚀 SESSION BOOTSTRAP

> Output at the very start of EVERY conversation — no exceptions.

```
🧠 AI Context — Session Active
```
"""

def build_context_size_audit(aictx_home: Path, resources: dict, context_root: Optional[Path] = None) -> str:
    """Generate the Context Size Audit block dynamically based on file sizes."""
    audit = ["## 📊 Context Size Audit\n"]

    root = context_root or aictx_home

    # P0 Rules Baseline
    rules_dir = root / "rules"
    p0_sizes = []
    total_p0_size = 0.0
    if rules_dir.exists():
        for md_file in sorted(rules_dir.glob("*.md")):
            size_kb = _file_size_kb(md_file)
            if size_kb <= 0:
                continue
            p0_sizes.append(f"{md_file.stem}({size_kb:.1f})")
            total_p0_size += size_kb

    audit.append(f"**P0 Baseline (~{total_p0_size:.0f} KB)**: {', '.join(p0_sizes)}")
    audit.append("**Thresholds**: Safe ≤ 40KB | Warn 41–80KB | Block > 80KB")
    audit.append("**Dynamic load manifest**: .ai-context/.context-sizes.json\n")

    # Agents sizes
    agents_dir = root / "agents"
    agent_sizes = []
    if agents_dir.exists():
        for agent in resources.get("agents", []):
            try:
                if agent.get("type") == "directory":
                    agent_file = agents_dir / agent["name"] / "agent.md"
                else:
                    agent_file = agents_dir / f"{agent['name']}.md"
                if agent_file.exists():
                    size_kb = _file_size_kb(agent_file)
                    if size_kb >= 3.0:
                        agent_sizes.append(f"{agent['name']}({size_kb:.1f})")
            except Exception:
                pass
    if agent_sizes:
        audit.append(f"**Agents > 3KB**: {', '.join(agent_sizes)}")

    # Large Skills
    skills_dir = root / "skills"
    skill_sizes = []
    if skills_dir.exists():
        for skill in resources.get("skills", []):
            try:
                skill_file = skills_dir / skill["name"] / "SKILL.md"
                if skill_file.exists():
                    size_kb = _file_size_kb(skill_file)
                    if size_kb > 6.0:
                        skill_sizes.append(f"{skill['name']}({size_kb:.1f})")
            except Exception:
                pass
    if skill_sizes:
        audit.append(f"**Skills > 6KB**: {', '.join(skill_sizes)}")

    audit.append("\n**Action:** Check cumulative (Baseline + load) before loading artifacts. Block if > 80 KB.\n")
    return "\n".join(audit)

def build_always_md(aictx_home: Path, resources: dict, context_root: Optional[Path] = None) -> str:
    """Generate ALWAYS.md — hybrid: minimal protocol + embedded rule files.
    
    If context is disabled, returns a minimal disabled stub.
    """
    from datetime import datetime
    now = datetime.now().strftime("%Y-%m-%d %H:%M")
    
    # Check if context is disabled
    if not is_context_enabled():
        return build_disabled_always_stub()
    
    bootstrap = build_bootstrap_block()

    # Meta-skills: tag=meta in SKILL.md frontmatter
    meta_skills = [s for s in resources["skills"] if s.get("tag") == "meta"]
    if meta_skills:
        meta_list = "\n".join(
            "- **" + s["name"] + "**: " + (s.get("description", "")[:120].rsplit(" ", 1)[0] + "..." if len(s.get("description", "")) > 120 else s.get("description", ""))
            for s in meta_skills
        )
    else:
        meta_list = "> (none)"

    def _fmt_refs(items: List[dict], limit: int) -> str:
        names = sorted([i.get("name", "").strip() for i in items if i.get("name")])
        if not names:
            return "(none)"
        if len(names) <= limit:
            return ", ".join(f"`{n}`" for n in names)
        shown = names[:limit]
        return ", ".join(f"`{n}`" for n in shown) + f" … (+{len(names) - limit} more)"

    agents_ref   = f"{len(resources['agents'])} total — " + _fmt_refs(resources["agents"], limit=8)
    skills_ref   = f"{len(resources['skills'])} total — " + _fmt_refs(resources["skills"], limit=12)
    workflow_ref = f"{len(resources['workflows'])} total — " + _fmt_refs(resources["workflows"], limit=8)
    rules_ref    = f"{len(resources['rules'])} total — " + _fmt_refs(resources["rules"], limit=12)

    home_str     = "./.ai-context"
    now_str      = now
    return (
        "---\n"
        "trigger: always_on\n"
        'applyTo: "**"\n'
        "---\n\n"
        "# ALWAYS-ON RULES (P0)\n\n"
        "> ⚠️  **Auto-generated by `aictx sync`.**\n"
        "> Last sync: " + now_str + " | Source: `" + home_str + "`\n\n"
        "---\n\n"
        + bootstrap +
        "---\n\n"
        "## 🔴 ENFORCEMENT PROTOCOL\n\n"
        "`P0 Rules → Meta-Skills → Agent (P1) → Domain Skills (P2) → Implement`\n\n"
        "| Level | Source | When Active | Priority |\n"
        "|-------|--------|-------------|----------|\n"
        "| **P0** | `rules/` | Always — every session | Highest |\n"
        "| **P1** | `agents/{agent}.md` | When agent is selected | High |\n"
        "| **P2** | `skills/{skill}/SKILL.md` | When skill loaded | Medium |\n\n"
        "---\n\n"
        "## 🧠 META-SKILLS (Always Active)\n\n"
        + meta_list + "\n\n"
        "---\n\n"
        "## 🤖 AGENT & SKILL ACTIVATION\n\n"
        "1. Analyze domain → 2. Select agent → 3. Load target skills/rules.\n\n"
        "**Announcement (always — before responding):**\n"
        "```\n"
        "> 🤖 **agent-name** · 🎯 **skill-name**\n"
        "```\n\n"
        "---\n\n"
        "## 📋 REQUEST CLASSIFIER\n\n"
        "| Intent | Keywords | Action |\n"
        "|--------|----------|--------|\n"
        '| **Question** | "how", "explain" | Text answer — no code |\n'
        '| **Simple** | "fix", "add" | Targeted edit — no expansion |\n'
        '| **Complex** | "build", "refactor" | Select agent → load skills → implement |\n'
        '| **Review** | "review", "audit" | Feedback only — no rewrites |\n\n'
        "---\n\n"
        "## 📦 QUICK REFERENCE\n\n"
        "**P0 Rules:** " + rules_ref + "\n\n"
        "**Agents:** " + agents_ref + "\n\n"
        "**Skills:** " + skills_ref + "\n\n"
        "**Workflows:** " + workflow_ref + "\n\n"
        "---\n\n"
        + build_context_size_audit(aictx_home, resources, context_root)
    )


def make_link(src: Path, dst: Path, force: bool = False) -> str:
    if not src.exists():
        return f"⚠  {dst.name} → source not found: {src}"
    if dst.is_symlink():
        if force:
            dst.unlink()
        else:
            if dst.resolve() == src.resolve():
                return f"✓  {dst.name} → already linked"
            return f"⚠  {dst.name} → wrong target (use --force to overwrite)"
    if dst.exists() and not dst.is_symlink():
        if force:
            import shutil
            shutil.rmtree(dst) if dst.is_dir() else dst.unlink()
        else:
            return f"⚠  {dst.name} → real path exists (use --force)"
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.symlink_to(src)
    return f"✓  {dst.name} → {src}"


def link_status(dst: Path, src: Path) -> str:
    if not dst.exists() and not dst.is_symlink():
        return "✗  not linked"
    if dst.is_symlink():
        resolved = dst.resolve()
        if resolved == src.resolve():
            return "✓  linked"
        if not dst.exists():
            return "⚠  broken link"
        return f"⚠  wrong target → {resolved}"
    return "⚠  real file/folder (not a symlink)"


def global_rule_status(context_root: Path, target: dict) -> Optional[str]:
    global_rule_path = target.get("global_rule")
    if not global_rule_path:
        return None

    if not global_rule_path.exists():
        return f"✗  global_rule ← {global_rule_path}"

    try:
        always_path = context_root / "rules" / "ALWAYS.md"
        if always_path.exists() and always_path.read_text() == global_rule_path.read_text():
            return f"✓  global_rule ← {global_rule_path}"
        return f"⚠  global_rule ← {global_rule_path} (mismatch)"
    except Exception as e:
        return f"⚠  global_rule ← {global_rule_path} ({e})"


def parse_jsonc(text: str) -> dict:
    """Parse JSONC (JSON with Comments + trailing commas)."""
    # Remove single-line comments
    text = re.sub(r"//[^\n]*", "", text)
    # Remove block comments
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    # Remove trailing commas before } or ]
    text = re.sub(r",\s*([\]}])", r"\1", text)
    return json.loads(text)


def _find_default_log_target() -> Optional[Path]:
    """Try to locate the newest Copilot chat debug log path."""
    env_target = os.environ.get("VSCODE_TARGET_SESSION_LOG")
    if env_target:
        p = Path(env_target).expanduser()
        if p.exists():
            return p

    logs_root = HOME / ".config/Code/User/workspaceStorage"
    if not logs_root.exists():
        return None

    candidates = []
    for p in logs_root.glob("**/GitHub.copilot-chat/debug-logs/**/*"):
        if p.is_file():
            try:
                candidates.append((p.stat().st_mtime, p))
            except OSError:
                continue

    if not candidates:
        return None

    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]


def _iter_log_files(target: Path) -> List[Path]:
    if target.is_file():
        return [target]

    allowed = {".json", ".jsonl", ".log", ".txt", ".md"}
    files = []
    for p in sorted(target.rglob("*")):
        if not p.is_file():
            continue
        if p.suffix.lower() in allowed:
            files.append(p)
    return files


def _safe_read_text(path: Path) -> str:
    try:
        return path.read_text(errors="ignore")
    except Exception:
        return ""


def _estimate_chars(file_path: str, start: Optional[int], end: Optional[int], cache: Dict) -> int:
    if not file_path or start is None or end is None:
        return 0

    try:
        p = Path(file_path).expanduser()
        if not p.is_absolute():
            p = AICTX_HOME / p
        p = p.resolve()
    except Exception:
        return 0

    key = (str(p), start, end)
    if key in cache:
        return cache[key]

    if not p.exists() or p.is_dir():
        cache[key] = 0
        return 0

    try:
        lines = p.read_text(errors="ignore").splitlines(keepends=True)
    except Exception:
        cache[key] = 0
        return 0

    start_i = max(start, 1) - 1
    end_i = min(end, len(lines))
    if end_i <= start_i:
        cache[key] = 0
        return 0

    chars = len("".join(lines[start_i:end_i]))
    cache[key] = chars
    return chars


def cmd_telemetry(args):
    """Analyze read_file telemetry from chat/debug logs."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()

    target_input = args.path
    if target_input:
        target = Path(target_input).expanduser()
    else:
        target = _find_default_log_target()

    if not target or not target.exists():
        print("\n❌ No log target found.")
        print("   Provide a file/folder path: aictx telemetry <path-to-log>")
        return 1

    files = _iter_log_files(target)
    if not files:
        print(f"\n❌ No readable log files found at: {target}")
        return 1

    request_marker_re = re.compile(r'"role"\s*:\s*"user"|<userRequest>|^\s*User\s*:', re.IGNORECASE)
    read_call_re = re.compile(
        r'functions\.read_file|["\']name["\']\s*:\s*["\']read_file["\']|'
        r'["\']tool["\']\s*:\s*["\']read_file["\']|recipient_name["\']?\s*:\s*["\']functions\.read_file["\']',
        re.IGNORECASE,
    )
    file_path_re = re.compile(r'["\']filePath["\']\s*:\s*["\']([^"\']+)["\']')
    start_re = re.compile(r'["\']startLine["\']\s*:\s*(\d+)')
    end_re = re.compile(r'["\']endLine["\']\s*:\s*(\d+)')

    req_offset = 0
    req_metrics = {}
    file_counter = Counter()
    chars_cache = {}

    for log_file in files:
        text = _safe_read_text(log_file)
        if not text.strip():
            continue

        lines = text.splitlines()
        req_id_local = 0
        per_req_local = defaultdict(lambda: {
            "read_calls": 0,
            "files": set(),
            "lines_requested": 0,
            "chars_estimated": 0,
        })

        for idx, line in enumerate(lines):
            if request_marker_re.search(line):
                req_id_local += 1

            if not read_call_re.search(line):
                continue

            if req_id_local == 0:
                req_id_local = 1

            global_req_id = req_offset + req_id_local
            window = "\n".join(lines[idx:idx + 40])

            fp_match = file_path_re.search(window)
            st_match = start_re.search(window)
            en_match = end_re.search(window)

            file_path = fp_match.group(1) if fp_match else ""
            start = int(st_match.group(1)) if st_match else None
            end = int(en_match.group(1)) if en_match else None
            lines_requested = (end - start + 1) if (start is not None and end is not None and end >= start) else 0
            chars_estimated = _estimate_chars(file_path, start, end, chars_cache)

            m = per_req_local[global_req_id]
            m["read_calls"] += 1
            if file_path:
                m["files"].add(file_path)
                file_counter[file_path] += 1
            m["lines_requested"] += lines_requested
            m["chars_estimated"] += chars_estimated

        if req_id_local > 0:
            req_offset += req_id_local
            for rid, data in per_req_local.items():
                req_metrics[rid] = data

    if not req_metrics:
        print("\n⚠️  No read_file tool calls found in the selected logs.")
        print(f"   Target analyzed: {target}")
        return 0

    total_calls = sum(v["read_calls"] for v in req_metrics.values())
    total_lines = sum(v["lines_requested"] for v in req_metrics.values())
    total_chars = sum(v["chars_estimated"] for v in req_metrics.values())
    total_tokens_est = int(total_chars / 4) if total_chars > 0 else 0
    total_requests = len(req_metrics)

    top_files = [
        {"file": path, "reads": count}
        for path, count in file_counter.most_common(args.top_files)
    ]

    report = {
        "generatedAt": datetime.now().isoformat(timespec="seconds"),
        "target": str(target),
        "filesScanned": len(files),
        "summary": {
            "requests": total_requests,
            "readCalls": total_calls,
            "uniqueFiles": len(file_counter),
            "linesRequested": total_lines,
            "charsEstimated": total_chars,
            "tokensEstimated": total_tokens_est,
            "avgReadsPerRequest": round(total_calls / total_requests, 2),
            "avgLinesPerRequest": round(total_lines / total_requests, 2),
        },
        "byRequest": [
            {
                "request": rid,
                "readCalls": req_metrics[rid]["read_calls"],
                "uniqueFiles": len(req_metrics[rid]["files"]),
                "linesRequested": req_metrics[rid]["lines_requested"],
                "tokensEstimated": int(req_metrics[rid]["chars_estimated"] / 4) if req_metrics[rid]["chars_estimated"] > 0 else 0,
            }
            for rid in sorted(req_metrics)
        ],
        "topFiles": top_files,
    }

    if args.output:
        out_path = Path(args.output).expanduser()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(json.dumps(report, indent=2) + "\n")

    if args.json:
        print(json.dumps(report, indent=2))
        return 0

    B = "\033[1m"; G = "\033[92m"; Y = "\033[93m"; R = "\033[0m"; DIM = "\033[2m"; C = "\033[96m"

    print(f"\n{B}📊 AI Context — Telemetry{R}")
    print(f"   {DIM}Target: {report['target']}{R}")
    print(f"   {DIM}Scanned: {report['filesScanned']} log files{R}\n")

    print(f" {B}📈 USAGE SUMMARY{R}")
    print(f"   Requests       : {B}{report['summary']['requests']}{R}")
    print(f"   Read Calls     : {B}{report['summary']['readCalls']}{R}")
    print(f"   Unique Files   : {B}{report['summary']['uniqueFiles']}{R}")
    print(f"   Lines Total    : {B}{report['summary']['linesRequested']}{R}")
    
    t_tokens = report['summary']['tokensEstimated']
    token_color = G if t_tokens < 50000 else (Y if t_tokens < 150000 else R)
    print(f"   Est. Tokens    : {token_color}{t_tokens}{R} {DIM}(heuristic: chars/4){R}\n")

    print(f" {B}📋 BY REQUEST{R}")
    header = f"   {'ID':<5} | {'Reads':<8} | {'Files':<8} | {'Lines':<10} | {'Tokens':<8}"
    print(f"   {DIM}{header}{R}")
    print(f"   {DIM}{'─' * len(header)}{R}")
    
    for row in report["byRequest"]:
        t_est = row['tokensEstimated']
        t_color = G if t_est < 10000 else (Y if t_est < 30000 else R)
        print(
            f"   {str(row['request']).ljust(5)} | "
            f"{str(row['readCalls']).ljust(8)} | "
            f"{str(row['uniqueFiles']).ljust(8)} | "
            f"{str(row['linesRequested']).ljust(10)} | "
            f"{t_color}{str(t_est).ljust(8)}{R}"
        )

    if top_files:
        print(f"\n {B}🔥 HOT FILES{R} {DIM}(most read){R}")
        for item in top_files:
            print(f"   {G}·{R} {item['file']:<40} {DIM}({item['reads']} reads){R}")

    print()
    return 0


def update_vscode_settings_paths(settings_path: Path, resources: list, context_root: Path):
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    data = {}
    if settings_path.exists():
        try:
            data = parse_jsonc(settings_path.read_text())
        except Exception as e:
            print(f"  ⚠  Could not parse {settings_path}: {e} — skipping")
            return

    locations = data.get("chat.instructionsFilesLocations", {})
    changed = False
    for resource in resources:
        legacy_abs = str(AICTX_HOME / resource)
        legacy_tilde = legacy_abs.replace(str(HOME), "~")
        if legacy_abs in locations:
            del locations[legacy_abs]
            changed = True
        if legacy_tilde in locations:
            del locations[legacy_tilde]
            changed = True

        abs_path = str(context_root / resource)
        tilde_path = abs_path.replace(str(HOME), "~")
        if abs_path in locations or tilde_path in locations:
            print_step(True, f"settings.json ← {resource} already registered")
        else:
            locations[abs_path] = True
            changed = True
            print_step(True, f"settings.json ← registered {resource}")

    if changed:
        data["chat.instructionsFilesLocations"] = locations
        with open(settings_path, "w") as f:
            json.dump(data, f, indent=2)


def safe_propagate(target_path: Path, content: str, label: str):
    """Writes content to target_path, creating a backup if file exists and differs."""
    # Safety: Do not propagate into the resource repository itself
    try:
        if str(AICTX_HOME) in str(target_path.resolve()):
            # Exception for manifests like .context-sizes.json which belong in AICTX_HOME
            if target_path.name not in [CONTEXT_SIZES_FILENAME, "ALWAYS.md"]:
                return False
    except Exception:
        pass

    if not target_path.parent.exists():
        return False
    
    backup_created = False
    if target_path.exists():
        try:
            existing = target_path.read_text()
            if existing != content:
                bak_path = target_path.with_suffix(target_path.suffix + ".bak")
                bak_path.write_text(existing)
                backup_created = True
        except Exception:
            pass
    
    try:
        target_path.write_text(content)
        details = f"{DIM}(Backup created){RES}" if backup_created else ""
        print_step(True, label, details)
        return True
    except Exception as e:
        print_step(False, label, str(e))
        return False


def cmd_sync(args):
    """Regenerate ALWAYS.md and refresh all AI tool configurations."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    
    print_header("🔄", "AI Context — Sync Center", f"Source: {AICTX_HOME}")

    resources = scan_resources(AICTX_HOME)
    archived  = list_archived_items(AICTX_HOME)
    context_root = ensure_runtime_tree(AICTX_HOME)

    print_section("📦 RESOURCES")
    for k in RESOURCES:
        active = len(resources.get(k, []))
        arch = len(archived.get(k.rstrip('s'), []))
        meta_str = f" {DIM}({sum(1 for s in resources['skills'] if s.get('tag') == 'meta')} meta){RES}" if k == "skills" else ""
        arch_str = f" {DIM}[{arch} archived]{RES}" if arch > 0 else ""
        print(f"   {k:<10} {B}{active:>2}{RES}{meta_str}{arch_str}")

    print_header("🔨", "MANIFESTS")
    content = build_always_md(AICTX_HOME, resources, context_root)
    always_path = context_root / "rules" / "ALWAYS.md"
    always_path.write_text(content)
    print_step(True, "ALWAYS.md", f"{str(always_path).replace(str(HOME), '~')}")
    
    sizes_path = AICTX_HOME / ".context-sizes.json"
    write_context_sizes_manifest(context_root, sizes_path)
    print_step(True, "context-sizes", f"{str(sizes_path).replace(str(HOME), '~')}")

    resources_manifest_path = AICTX_HOME / RESOURCES_MANIFEST_FILENAME
    write_resources_manifest(context_root, resources, resources_manifest_path)
    print_step(True, "resources-manifest", f"{str(resources_manifest_path).replace(str(HOME), '~')}")

    print_header("🔗", "PROPAGATION")
    
    # 1. Copilot Special Case
    copilot_instr = TARGETS["copilot"]["paths"]["instructions"]
    if safe_propagate(copilot_instr, content, "Copilot Instructions"):
        update_vscode_settings_paths(TARGETS["copilot"]["paths"]["settings"], RESOURCES, context_root)
    
    # 2. General Tool Overrides (Claude, Gemini, Cursor, Windsurf)
    for tk, target in TARGETS.items():
        if target["link_type"] == "folders":
            gr_path = target.get("global_rule")
            if gr_path:
                safe_propagate(gr_path, content, f"{tk.capitalize()} Override")

    print(f"\n✅ {G}Sync complete.{RES} All environments are up to date.\n")
    return 0


def cmd_install(args):
    """Install resource links to AI tools with a premium TUI."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    context_root = ensure_runtime_tree(AICTX_HOME)
    
    B = "\033[1m"; R = "\033[0m"

    selected_targets = []
    selected_resources = []

    if args.all:
        selected_targets = list(TARGETS.keys())
        selected_resources = RESOURCES
    else:
        # Target Selection
        target_items = [
            {"name": k, "desc": v["description"]} 
            for k, v in TARGETS.items()
        ]
        selection = TUISelector.select("Select installation targets (Space to toggle, Enter to confirm):", target_items, multi=True)
        if not selection: return 0
        selected_targets = [s["name"] for s in selection]

        # Resource Selection
        res_items = [{"name": r, "desc": f"Link all active {r}"} for r in RESOURCES]
        selection = TUISelector.select("Select resources to link:", res_items, multi=True)
        if not selection: return 0
        selected_resources = [s["name"] for s in selection]

    if not selected_targets or not selected_resources:
        print("\nNothing selected. Aborting.\n")
        return 0

    print(f"\n{B}🚀 AI Context — Installing Links{R}")
    
    for target_key in selected_targets:
        target = TARGETS[target_key]
        print(f" {B}🔗 {target_key}{RES} {DIM}— {target['description']}{RES}")

        if target["link_type"] == "copilot":
            instr_path = target["paths"]["instructions"]
            instr_path.parent.mkdir(parents=True, exist_ok=True)
            always_path = context_root / "rules" / "ALWAYS.md"
            instr_path.write_text(
                always_path.read_text() if always_path.exists()
                else "# ALWAYS.md not found — run: aictx sync\n"
            )
            print(f"  ✓  {instr_path.name} ← written from ALWAYS.md")
            update_vscode_settings_paths(target["paths"]["settings"], selected_resources, context_root)

        elif target["link_type"] == "folders":
            base = target["base"]
            base.mkdir(parents=True, exist_ok=True)
            for resource in selected_resources:
                src = context_root / resource
                dst = base / resource
                print(f"  {make_link(src, dst, force=args.force)}")

            if target.get("global_rule"):
                global_rule_path = target["global_rule"]
                global_rule_path.parent.mkdir(parents=True, exist_ok=True)
                always_path = context_root / "rules" / "ALWAYS.md"
                if always_path.exists():
                    global_rule_path.write_text(always_path.read_text())
                    print(f"  ✓  {global_rule_path.name} ← written from ALWAYS.md")
                else:
                    print(f"  ⚠  {global_rule_path.name} ← ALWAYS.md not found, run: aictx sync")

    print(f"\n✅ Installation complete. Run `aictx status` to verify.\n")
    return 0


def cmd_status(args):
    """Show the status of linked resources with a premium UI."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    context_root = resolve_context_root(AICTX_HOME)
    state = read_context_state()
    is_enabled = state.get("context_enabled", True)
    
def cmd_status(args):
    """Show the status of linked resources with a premium UI."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    context_root = resolve_context_root(AICTX_HOME)
    state = read_context_state()
    is_enabled = state.get("context_enabled", True)
    
    status_emoji = "✅" if is_enabled else "⏸️"
    status_text = f"{G}ENABLED{RES}" if is_enabled else f"{Y}DISABLED{RES}"
    
    print_header(status_emoji, "AI Context — Status Center", f"Source: {AICTX_HOME}")
    
    resources = scan_resources(AICTX_HOME)
    archived  = list_archived_items(AICTX_HOME)
    
    print_section("📦 CURRENT RESOURCES")
    for k in RESOURCES:
        active = len(resources.get(k, []))
        arch = len(archived.get(k.rstrip('s'), []))
        meta_str = f" {DIM}({sum(1 for s in resources['skills'] if s.get('tag') == 'meta')} meta){RES}" if k == "skills" else ""
        arch_str = f" {DIM}[{arch} archived]{RES}" if arch > 0 else ""
        print(f"   {k:<10} {B}{active:>2}{RES}{meta_str}{arch_str}")
    print()

    TARGET_ICONS = {
        "copilot": "🤖", "claude": "🐚", "gemini": "✨", "cursor": "🏹", "windsurf": "🏄"
    }

    for target_key, target_icon in TARGET_ICONS.items():
        conf = TARGETS.get(target_key)
        if not conf: continue
        
        print(f" {target_icon} {B}{target_key.upper()}{RES} {DIM}— {conf['description']}{RES}")
        
        # Link Status
        if conf["link_type"] == "copilot":
            instr = conf["paths"]["instructions"]
            status_icon = f"{G}✓{RES}" if instr.exists() else f"{Y}✗{RES}"
            link_label = "Linked" if instr.exists() else "Not Linked"
            print(f"   {status_icon} {B}{link_label}{RES}  → {DIM}{str(instr.parent).replace(str(HOME), '~')}{RES}")
        else:
            base = conf["base"]
            linked_res = []
            missing_res = []
            for res in RESOURCES:
                dst = base / res
                src = context_root / res
                status = link_status(dst, src)
                if "✓" in status: linked_res.append(res)
                else: missing_res.append(res)
            
            if not missing_res: status_icon, label = f"{G}🔗{RES}", "Linked"
            elif linked_res: status_icon, label = f"{Y}⚠{RES}", "Partial"
            else: status_icon, label = f"{DIM}∅{RES}", "Not Linked"
            
            print(f"   {status_icon} {B}{label}{RES}  → {DIM}{str(base).replace(str(HOME), '~')}{RES}")
            if missing_res:
                print(f"     {DIM}↳ Missing links: {Y}{', '.join(missing_res)}{RES}")

        # Override Status (ALWAYS.md)
        gr_path = conf.get("global_rule") or (conf["paths"]["instructions"] if conf.get("link_type") == "copilot" else None)
        if gr_path:
            gr_status = f"{G}✓{RES}" if gr_path.exists() else f"{DIM}✗{RES}"
            print(f"   {gr_status} {B}Override{RES} → {DIM}{str(gr_path).replace(str(HOME), '~')}{RES}")
        
        # Auto-injection (Copilot specific)
        if conf["link_type"] == "copilot":
            settings = conf["paths"]["settings"]
            is_injected = False
            if settings.exists():
                try:
                    data = parse_jsonc(settings.read_text())
                    locations = data.get("chat.instructionsFilesLocations", {})
                    # Check if any of our resource paths are in locations
                    for r in RESOURCES:
                        if any(str(context_root / r) in k or str(AICTX_HOME / r) in k for k in locations.keys()):
                            is_injected = True
                            break
                except Exception:
                    pass
            
            inj_status = f"{G}✓{RES}" if is_injected else f"{Y}✗{RES}"
            inj_label = "Injected" if is_injected else "Not Injected"
            print(f"   {inj_status} {B}{inj_label}{RES} → {DIM}Rules/Skills via settings.json{RES}")

        print()

        print()

    print(f" {DIM}{'─' * 60}{RES}")
    print(f" {DIM}Tip: Use 'aictx sync' to refresh all links and rules.{RES}\n")


def cmd_uninstall(args):
    """Remove managed links with a granular TUI selector."""
    global AICTX_HOME
    AICTX_HOME = resolve_aictx_home()
    context_root = resolve_context_root(AICTX_HOME)

    B = "\033[1m"; R = "\033[0m"
    
    # Build list of targets to uninstall
    target_items = [
        {"name": k, "desc": v["description"]} 
        for k, v in TARGETS.items()
    ]
    target_items.insert(0, {"name": "ALL", "desc": "🔥 Remove EVERYTHING (all links and settings)"})
    
    selection = TUISelector.select("Select targets to UNINSTALL (Space to toggle, Enter to confirm):", target_items, multi=True)
    
    if not selection:
        print("Aborted.\n")
        return

    selected_keys = [s["name"] for s in selection]
    if "ALL" in selected_keys:
        targets_to_remove = list(TARGETS.keys())
    else:
        targets_to_remove = selected_keys

    print(f"\n{B}🗑  AI Context — Uninstalling Links{R}\n")

    for target_key in targets_to_remove:
        target = TARGETS[target_key]
        print(f"🗑  {target_key}")

        if target["link_type"] == "copilot":
            instr = target["paths"]["instructions"]
            if instr.exists():
                instr.unlink()
                print(f"  ✓  removed {instr.name}")
            settings = target["paths"]["settings"]
            if settings.exists():
                try:
                    data = parse_jsonc(settings.read_text())
                    if "chat.instructionsFilesLocations" in data:
                        del data["chat.instructionsFilesLocations"]
                        settings.write_text(json.dumps(data, indent=2))
                        print("  ✓  removed chat.instructionsFilesLocations from settings.json")
                except Exception:
                    print("  ⚠  Could not update settings.json")

        elif target["link_type"] == "folders":
            base = target["base"]
            for resource in RESOURCES:
                dst = base / resource
                if dst.is_symlink():
                    dst.unlink()
                    print(f"  ✓  removed {resource}")
            
            # Also remove global override files
            if target.get("global_rule"):
                gr = target["global_rule"]
                if gr.exists():
                    gr.unlink()
                    print(f"  ✓  removed {gr.name}")

        print()

    print("✅ Uninstall complete.\n")
    return 0


